{
  "$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
  "extends": ["@vis.gl/dev-tools/biome.jsonc"],
  "files": {
    "includes": [
      "modules/**/*.js",
      "modules/**/*.jsx",
      "modules/**/*.ts",
      "modules/**/*.tsx",
      "test/**/*.js",
      "test/**/*.jsx",
      "test/**/*.ts",
      "test/**/*.tsx",
      "!modules/**/dist/**",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/.nyc_output/**"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "bracketSpacing": false
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none",
      "bracketSpacing": false
    }
  },
  "linter": {
    "rules": {
      "recommended": false,
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnreachable": "error"
      },
      "style": {
        "noContinue": "warn"
      },
      "suspicious": {
        "noConsole": "warn",
        "noDebugger": "error",
        "noDoubleEquals": "error",
        "noRedeclare": "error",
        "noShadowRestrictedNames": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["modules/log/src/utils/local-storage.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["modules/react-bench/src/components/bench-results.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["modules/stats/src/lib/stats.ts", "modules/seer/src/api.ts"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
